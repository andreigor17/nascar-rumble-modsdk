+    static void PumpReadCallbacks(IMemory m, int limit)
+    {
+        if (_pumpingRead) return;
+        _pumpingRead = true;
+        try
+        {
+            for (int i = 0; i < limit && _readActive; i++)
+            {
+                uint ready = _cbReady;
+                uint data = _cbData;
+                if (ready == 0 && data == 0) return;
+
+                int generation = _readGeneration;
+                int lba = CurrentLba;
+                lock (DiscLock)
+                    Runtime.Cd!.LoadSectorToFifo(Runtime.Cd.ReadSectorData(lba, 2340));
+                Dispatcher.LoadByLba(lba);
+
+                _lastIntr = DataReady;
+                _sectorConsumed = false;
+                DispatchCallback(ready, DataReady, m);
+                DispatchCallback(data, DataReady, m);
+                if (_readGeneration != generation) continue;
+                if (!_sectorConsumed) return;
+
+                AdvancePos(1);
+            }
+        }
+        finally
+        {
+            _pumpingRead = false;
+        }
+    }
+
