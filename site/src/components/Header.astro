---
import { href, SITE, type Lang } from '../consts';
import { t } from '../i18n/ui';
interface Props { lang: Lang; page?: string }
const { lang, page = 'home' } = Astro.props;
const tr = t(lang);
const nav = [
  { key: 'home', path: '/' },
  { key: 'devlog', path: '/devlog' },
  { key: 'gallery', path: '/gallery' },
  { key: 'cars', path: '/cars' },
  { key: 'roadmap', path: '/roadmap' },
  { key: 'tools', path: '/tools' },
  { key: 'about', path: '/about' },
] as const;
const currentPath = page === 'home' ? '/' : `/${page}`;
---
<header class="site-header">
  <div class="container nav">
    <a class="brand" href={href('/', lang)} aria-label="NASCAR Rumble Native">
      <span class="chrome">Rumble</span><span class="tagnative">NATIVE</span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-label="Menu">☰ Menu</button>
    <nav class="menu" aria-label={lang === 'pt' ? 'Principal' : 'Main'}>
      {nav.map((n) => (
        <a class={page === n.key ? 'active' : ''} aria-current={page === n.key ? 'page' : undefined} href={href(n.path, lang)}>{tr(`nav.${n.key}` as any)}</a>
      ))}
      <a href={SITE.github} target="_blank" rel="noopener">GitHub</a>
    </nav>
    <span class="lang">
      <a class={lang === 'pt' ? 'active' : ''} href={href(currentPath, 'pt')} hreflang="pt-BR">PT</a>
      <a class={lang === 'en' ? 'active' : ''} href={href(currentPath, 'en')} hreflang="en">EN</a>
    </span>
  </div>
</header>
