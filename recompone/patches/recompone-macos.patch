@@ -56,0 +63,36 @@
+    public static void CardComplete(CpuContext c, IMemory m, uint port, uint? requestedSpec = null, bool immediate = true)
+    {
+        _pendingCardCompletions.Enqueue(new CardCompletion(port, requestedSpec, immediate));
+        if (!immediate || _deliveringCardCompletion) return;
+
+        _deliveringCardCompletion = true;
+        try
+        {
+            int guard = 0;
+            while (_pendingCardCompletions.Count != 0 && _pendingCardCompletions.Peek().Immediate && guard++ < 128)
+                DeliverCardCompletion(c, m, _pendingCardCompletions.Dequeue());
+        }
+        finally
+        {
+            _deliveringCardCompletion = false;
+        }
+    }
+
+    public static void TickCard(IMemory m)
+    {
+        var c = Runtime.Cpu;
+        if (c == null || _pendingCardCompletions.Count == 0) return;
+        DeliverCardCompletion(c, m, _pendingCardCompletions.Dequeue());
+    }
+
+    public static void CardInfo(CpuContext c, IMemory m, uint port)
+    {
+        int slot = (port & 0x10u) != 0 ? 1 : 0;
+        var card = slot == 1 ? Runtime.CardB : Runtime.CardA;
+        uint spec = !card.Enabled ? 0x0100u : _cardKnown[slot] ? 0x0004u : 0x2000u;
+        _cardKnown[slot] = card.Enabled;
+        CardComplete(c, m, port, spec, immediate: !_cardInitialized[slot]);
+    }
+
+    public static void CardLoad(CpuContext c, IMemory m, uint port) => CardComplete(c, m, port);
+
