# === NUNCA versionar a ISO original ou dumps de disco ===
*.bin
*.cue
*.iso
*.img
*.mdf
*.mds
NASCAR Rumble (USA)/

# Recursos extraídos (regeneráveis a partir da ISO)
extracted/
!extracted/.gitkeep

# Emulador: savestates, memory cards, BIOS
emulator/**
!emulator/.gitkeep
*.mcd
*.mcr
*.srm
*.sav
saves/*.mcd
saves/*.mcr
*.savestate
*.state
*.pxstate

# Ghidra: manter apenas exports .gzf/.xml, ignorar projeto de trabalho (qualquer nível)
*.rep/
*.gpr
*.lock
*.ghpr
# extensões do Ghidra (blob de 9MB, rebaixável via ROTEIRO_SETUP.md)
tools/ghidra_extensions/*.zip
ghidra/*.rep
# venv do PyGhidra e logs de execução
.venv-ghidra/
ghidra_out_run*.log
# saídas grandes do Ghidra (regeneráveis); versionamos só os CSVs de índice
ghidra_out/decomp_all.c
ghidra_out/func_*.c

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Etapa 2: ferramentas e saídas reproduzíveis, geradas localmente
tools/splat/
tools/psyq_sdk/
tools/psyq-sdk/
!requirements-splat.lock
!requirements-decomp.lock
tools/asm-differ/
tools/maspsx/
tools/objdiff/
tools/wibo/
build/
asm/
assets/
scratch/
.splache
config/undefined_funcs_auto.txt
config/undefined_syms_auto.txt
include/gte_macros.inc
include/include_asm.h
include/labels.inc
include/macro.inc
linker/*.d

# Sistema
.DS_Store
Thumbs.db

# jpsxdec (baixado; ~MB)
tools/jpsxdec/

# logs de ferramentas
debug*.log

# snapshots de RAM do PCSX-Redux (regeneráveis)
experiments/ram/

# clone do RecompOne (build)
tools/RecompOne/
tools/compiler_probe/build/

# RecompOne: código gerado e build do host
recompone/Recompiled/
recompone/host/bin/
recompone/host/obj/

recompone/boot.log
recompone/host/settings.json
recompone/*.sav
settings.json
interface.ini
