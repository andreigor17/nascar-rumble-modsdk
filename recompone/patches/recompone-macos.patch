diff --git a/RecompOne.Runtime/Gpu/Hle/Gl/GlVram.cs b/RecompOne.Runtime/Gpu/Hle/Gl/GlVram.cs
--- a/RecompOne.Runtime/Gpu/Hle/Gl/GlVram.cs
+++ b/RecompOne.Runtime/Gpu/Hle/Gl/GlVram.cs
@@ -58 +58,11 @@
-    public void Barrier() => _gl.TextureBarrier();
+    public void Barrier()
+    {
+        if (OperatingSystem.IsMacOS())
+        {
+            // macOS stops at OpenGL 4.1 and does not expose glTextureBarrier (4.5).
+            // Finish is conservative, but keeps the first native boot path functional.
+            _gl.Finish();
+            return;
+        }
+        _gl.TextureBarrier();
+    }
