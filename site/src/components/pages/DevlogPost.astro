---
import { href, type Lang } from '../../consts';
import { t } from '../../i18n/ui';
import type { DevlogEntry } from '../../data/devlog';
const { lang, entry } = Astro.props as { lang: Lang; entry: DevlogEntry };
const tr = t(lang);
const c = entry[lang];
const img = entry.image ? `${import.meta.env.BASE_URL}${entry.image}`.replace('//', '/') : null;
---
<section class="section">
  <div class="container">
    <a class="back" href={href('/devlog', lang)}>{tr('devlog.back')}</a>
    <p class="eyebrow" style="display:flex">{entry.tag} · #{entry.session} · {entry.date}</p>
    <h1 class="chrome title" style="max-width:24ch">{c.title}</h1>
    <hr class="rule" />
    <div class="prose">
      <p style="font-size:1.15rem; color:var(--white)">{c.summary}</p>
      {img && (
        <div class="shot" style="margin:24px 0; max-width:820px">
          <img src={img} alt={c.title} loading="lazy" />
        </div>
      )}
      <ul>
        {c.points.map((p) => <li>{p}</li>)}
      </ul>
    </div>
  </div>
</section>
